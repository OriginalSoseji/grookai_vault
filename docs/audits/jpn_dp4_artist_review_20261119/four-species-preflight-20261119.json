      "conname": "card_print_species_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "conname": "card_print_species_role_check",
      "contype": "c",
      "definition": "CHECK ((role = ANY (ARRAY['primary'::text, 'tag_team'::text, 'multi_subject'::text, 'trainer_owned'::text, 'form_subject'::text, 'cameo'::text, 'manual_override'::text])))"
    },
