export type EventExpenseCategory='booth'|'travel'|'lodging'|'meals'|'supplies'|'fees'|'other';
export type EventFields={eventId:string;name:string;startDate:string;endDate:string;timeZone:string;currency:'USD';notes:string};
export type EventExpenseFields={eventId:string;expenseId:string;category:EventExpenseCategory;description:string;amountMinor:string;currency:'USD';incurredOn:string};
export type EventOperation=({type:'event_create'|'event_update'}&EventFields)|{type:'event_close'|'event_reopen';eventId:string;reason:string}|({type:'expense_create'}&EventExpenseFields)|({type:'expense_update';reason:string}&EventExpenseFields)|{type:'expense_void';eventId:string;expenseId:string;reason:string}|{type:'receipts_assign';eventId:string|null;receipts:{receiptId:string;previousEventId:string|null}[]};
export type EventRequest={version:1;requestId:string;expectedRevision:string;operation:EventOperation};
export type EventAcknowledgement={version:1;ownerId:string;requestId:string;previousRevision:string;revision:string;operation:EventOperation};
export const eventExpenseCategories:readonly EventExpenseCategory[];
export function validateEventOperation(value:unknown):EventOperation;
export function validateEventRequest(value:unknown):EventRequest;
export function confirmedEventRequest(request:unknown,result:unknown,ownerId:string):EventAcknowledgement;
export function eventRequestParams(request:unknown):{p_request:EventRequest};
export function eventMoneyInput(value:unknown):string|null;
export function eventMoneyText(minor:string):string;
export type VendorEvent=EventFields&{status:'open'|'closed';stateReason:string;revision:string;createdAt:string;updatedAt:string};
export type EventExpense=EventExpenseFields&{voided:boolean;lastReason:string;revision:string;createdAt:string;updatedAt:string};
export type EventSelection={eventId:string;expenses:EventExpense[];assignments:{receiptId:string;eventId:string|null;revision:string}[];candidates:{receiptId:string;localDate:string;previousEventId:string|null}[]|null;receiptIdentityConflicts:string[];bookRevision:string|null};
export type EventState={version:1;ownerId:string;revision:string;entryEnabled:boolean;receiptAccess:boolean;events:VendorEvent[];selected:EventSelection|null};
export function validateEventState(value:unknown,ownerId:string,selectedId?:string|null):EventState;
export type EventHistory={version:1;ownerId:string;eventId:string;rows:{requestId:string;revision:string;createdAt:string;operation:EventOperation}[];nextRevision:string|null};
export function validateEventHistory(value:unknown,ownerId:string,eventId:string,beforeRevision?:string|null,limit?:number):EventHistory;
