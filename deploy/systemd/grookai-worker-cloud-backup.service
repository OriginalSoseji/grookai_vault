[Unit]
Description=Grookai verified private worker backups
Wants=network-online.target
After=network-online.target
OnFailure=grookai-operations-webhook@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/grookai_worker_backup_current
EnvironmentFile=/etc/grookai/mee-nightly.env
Environment=NODE_ENV=production
Environment=DOTENV_CONFIG_PATH=/etc/grookai/worker-backup-no-dotenv
ExecStart=/usr/bin/flock -n /run/lock/grookai-worker-cloud-backup.lock /usr/bin/flock -n /run/lock/grookai-mee-nightly.lock /usr/bin/node scripts/workers/worker_cloud_backup_v1.mjs
TimeoutStartSec=2h
TimeoutStopSec=30s
KillMode=control-group
Nice=10
CPUQuota=50%
MemoryMax=512M
IOWeight=25
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/grookai/worker-cloud-backups /run/lock/grookai-worker-cloud-backup.lock /run/lock/grookai-mee-nightly.lock

[Install]
WantedBy=multi-user.target
