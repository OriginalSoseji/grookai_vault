[Unit]
Description=Grookai commerce health
Wants=network-online.target
After=network-online.target
OnFailure=grookai-commerce-alert@%n.service

[Service]
Type=oneshot
User=grookai
WorkingDirectory=/opt/grookai_vault_commerce
EnvironmentFile=/etc/grookai/commerce.env
Environment=DOTENV_CONFIG_PATH=/dev/null
ExecStart=/usr/bin/env node --experimental-strip-types backend/payments/vendor_commerce_worker_v1.mjs --health
TimeoutStartSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

