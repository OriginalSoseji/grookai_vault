# Copy to /etc/grookai/tcgplayer-market-pricing.env.
# Never commit the populated production file.

NODE_ENV=production
SUPABASE_DB_URL=

# Live scheduled writes remain disabled until the production deployment gate.
TCGPLAYER_MARKET_SCHEDULE_ALLOW_RUN=0
TCGPLAYER_MARKET_SCHEDULE_MODE=shadow
TCGPLAYER_MARKET_SCHEDULE_MAX_ATTEMPTS=3
TCGPLAYER_MARKET_SCHEDULE_RETRY_DELAYS_SECONDS=60,300
TCGPLAYER_MARKET_SCHEDULE_REQUEST_CEILING=10000
TCGPLAYER_MARKET_PHASE_TIMEOUT_MINUTES=120
TCGPLAYER_MARKET_DATABASE_TIMEOUT_MINUTES=20
TCGPLAYER_MARKET_SCHEDULE_FRESHNESS_HOURS=36
TCGPLAYER_MARKET_SCHEDULE_PUBLICATION_LIMIT=
# Required only in canary mode. The definition must be verified and exact.
TCGPLAYER_MARKET_SCHEDULE_CANARY_DEFINITION=
TCGPLAYER_MARKET_SCHEDULE_OUT_ROOT=/var/lib/grookai/market-pricing

# Set only after replacement shadow cycles prove the combined pipeline.
TCGPLAYER_MARKET_REPLACEMENT_VERIFIED=0

# Required generic human notification route. Keep both values secret.
GROOKAI_OPERATIONS_WEBHOOK_URL=
GROOKAI_OPERATIONS_WEBHOOK_BEARER_TOKEN=
GROOKAI_OPERATIONS_NOTIFICATION_STATE_DIR=/var/lib/grookai/operations-notifications
